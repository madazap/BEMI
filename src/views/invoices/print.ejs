<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Recibo #<%= invoiceData.id %> — Dra. Maria Belen Navarro</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Montserrat', system-ui, sans-serif; font-size: 12px; color: #2c2f2c; padding: 36px; background: #fff; }

    /* Header */
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 2px solid #B0845B; }
    .header-left { display: flex; flex-direction: column; }
    .logo-img { height: 120px; width: auto; margin-bottom: 10px; }
    .doctor-name { font-family: 'Cormorant Garamond', serif; font-size: 15px; font-weight: 600; color: #5F816F; margin-bottom: 5px; }
    .contact-info { font-size: 10px; color: #7a7d78; line-height: 1.8; }

    .doc-info { text-align: right; padding-top: 8px; }
    .doc-title { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 700; color: #5F816F; letter-spacing: 0.06em; }
    .doc-number { font-size: 13px; color: #B0845B; font-weight: 600; margin-bottom: 10px; }
    .doc-meta { font-size: 11px; color: #7a7d78; line-height: 2; }
    .doc-meta strong { color: #2c2f2c; }

    /* Badge estado */
    .status-badge { display: inline-block; margin-top: 6px; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
    .status-pagado  { background: #eef3f0; color: #5F816F; border: 1px solid #5F816F; }
    .status-parcial { background: #fff8e1; color: #a06000; border: 1px solid #B0845B; }
    .status-pendiente { background: #fdecea; color: #b71c1c; border: 1px solid #e57373; }

    /* Sections */
    .section { margin-bottom: 22px; }
    .section-title { font-size: 9px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: .12em; color: #5F816F; margin-bottom: 10px; padding-bottom: 5px; border-bottom: 1px solid #e0d9d0; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px 24px; }
    .info-grid p { font-size: 12px; }

    /* Tables */
    table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
    th { background: #eef3f0; font-family: 'Montserrat', sans-serif; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; padding: 9px 10px; text-align: left; color: #5F816F; border-bottom: 1px solid #c5d5cc; }
    td { padding: 9px 10px; border-bottom: 1px solid #ede8e0; font-size: 12px; vertical-align: middle; }
    tbody tr:last-child td { border-bottom: none; }
    .total-row td { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 14px; background: #5F816F; color: #fff; border: none; }

    /* Balance pagos */
    .balance-row { display: flex; justify-content: flex-end; gap: 32px; margin-top: 14px; padding-top: 14px; border-top: 1px solid #e0d9d0; }
    .balance-item { text-align: right; }
    .balance-item span { display: block; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; color: #7a7d78; margin-bottom: 2px; }
    .balance-item strong { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 700; color: #2c2f2c; }
    .balance-item.pending strong { color: #b71c1c; }
    .balance-item.paid strong { color: #5F816F; }

    /* Firmas */
    .firmas { margin-top: 48px; display: flex; justify-content: space-around; }
    .firma-block { text-align: center; }
    .firma-line { width: 180px; border-top: 1px solid #2c2f2c; padding-top: 8px; font-size: 10px; color: #7a7d78; font-family: 'Montserrat', sans-serif; letter-spacing: .04em; }

    /* Nota pie */
    .footer-note { margin-top: 28px; padding: 10px 14px; border-left: 3px solid #B0845B; background: #faf5ee; font-size: 10px; color: #5a5a5a; line-height: 1.8; }
    .footer-note strong { color: #B0845B; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; }

    /* Botón */
    .print-btn { margin-top: 28px; padding: 10px 28px; background: #5F816F; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-family: 'Montserrat', sans-serif; font-weight: 500; cursor: pointer; letter-spacing: .04em; }
    .print-btn:hover { background: #4a6657; }
    @media print { .print-btn { display: none; } }
  </style>
</head>
<body>

  <div class="header">
    <div class="header-left">
      <img src="/img/Logo.png" class="logo-img" alt="BEMI">
      <div class="doctor-name">Dra. Maria Belen Navarro</div>
      <div class="contact-info">
        Tel. +57 301 391 2240<br>
        Cra. 5 # 9-26 Sur, C.E. Sabana Park, Torre 2 Cons. 506<br>
        Cajicá, Cundinamarca
      </div>
    </div>
    <div class="doc-info">
      <div class="doc-title">RECIBO DE CAJA</div>
      <div class="doc-number">#<%= String(invoiceData.id).padStart(4,'0') %></div>
      <div class="doc-meta">
        <p>Fecha: <strong><%= new Date(invoiceData.created_at).toLocaleDateString('es-CO') %></strong></p>
      </div>
      <span class="status-badge status-<%= invoiceData.status %>"><%= invoiceData.status %></span>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Paciente</div>
    <div class="info-grid">
      <p><strong>Nombre:</strong> <%= invoiceData.patient_name %></p>
      <p><strong>Documento:</strong> <%= invoiceData.patient_document_type %> <%= invoiceData.patient_document %></p>
      <p><strong>Correo:</strong> <%= invoiceData.patient_email || '—' %></p>
      <% if (invoiceData.treatment_name) { %>
        <p><strong>Plan:</strong> <%= invoiceData.treatment_name %></p>
      <% } %>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Detalle de servicios</div>
    <table>
      <thead>
        <tr>
          <th>Descripción</th>
          <th style="width:60px">Cant.</th>
          <th style="width:120px">Precio Unit.</th>
          <th style="width:120px;text-align:right">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% invoiceData.items.forEach(item => { const isDisc = item.item_type === 'descuento'; const sub = item.quantity * item.unit_price; %>
          <tr<%- isDisc ? ' style="color:#5F816F;font-style:italic"' : '' %>>
            <td><%= item.description %></td>
            <td><%= isDisc ? '' : item.quantity %></td>
            <td><%= isDisc ? '' : '$' + Number(item.unit_price).toLocaleString('es-CO') %></td>
            <td style="text-align:right"><%= (sub < 0 ? '-$' : '$') + Math.abs(sub).toLocaleString('es-CO') %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="total-row">
          <td colspan="3" style="text-align:right">TOTAL</td>
          <td style="text-align:right">$<%= Number(invoiceData.total_amount).toLocaleString('es-CO') %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if (invoiceData.payments && invoiceData.payments.length) { %>
  <div class="section">
    <div class="section-title">Pagos registrados</div>
    <table>
      <thead>
        <tr>
          <th>Método</th>
          <th style="text-align:right">Monto</th>
          <th style="width:120px;text-align:right">Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% invoiceData.payments.forEach(pay => { %>
          <tr>
            <td style="text-transform:capitalize"><%= pay.method %></td>
            <td style="text-align:right">$<%= Number(pay.amount).toLocaleString('es-CO') %></td>
            <td style="text-align:right"><%= new Date(pay.paid_at).toLocaleDateString('es-CO') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="balance-row">
      <div class="balance-item paid">
        <span>Total pagado</span>
        <strong>$<%= invoiceData.totalPaid.toLocaleString('es-CO') %></strong>
      </div>
      <div class="balance-item pending">
        <span>Saldo pendiente</span>
        <strong>$<%= invoiceData.totalPending.toLocaleString('es-CO') %></strong>
      </div>
    </div>
  </div>
  <% } %>

  <div class="firmas">
    <div class="firma-block">
      <div class="firma-line">Firma del Profesional</div>
    </div>
    <div class="firma-block">
      <div class="firma-line">Firma del Paciente</div>
    </div>
  </div>

  <div class="footer-note">
    <strong>Nota:</strong> Este documento es el comprobante oficial de los servicios prestados y pagos recibidos en el consultorio de la Dra. Maria Belen Navarro. Consérvelo como soporte de su transacción.
  </div>

  <button class="print-btn" onclick="window.print()">Imprimir / Guardar PDF</button>

</body>
</html>
