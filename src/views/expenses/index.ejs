<div class="period-selector">
  <form method="GET" action="/gastos" style="display:flex;gap:10px;align-items:center">
    <label for="selMonth">Mes:</label>
    <input type="month" id="selMonth" name="month" value="<%= month %>">
    <button type="submit" class="btn btn-primary btn-sm">Ver</button>
    <a href="/gastos/categorias" class="btn btn-sm">Gestionar Categorías</a>
    <a href="/gastos/informe" class="btn btn-sm">Informe de Ingresos y Egresos</a>
  </form>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px">

  <div class="form-card" style="max-width:none">
    <h3 style="margin-bottom:16px">Resumen — <%= month %></h3>
    <table style="width:100%;border-collapse:collapse">
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:8px 0;color:var(--muted)">Gastos fijos</td>
        <td style="padding:8px 0;text-align:right">$<%= summary.fixed_total.toLocaleString('es-CO') %></td>
      </tr>
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:8px 0;color:var(--muted)">Gastos ocasionales</td>
        <td style="padding:8px 0;text-align:right">$<%= summary.occasional_total.toLocaleString('es-CO') %></td>
      </tr>
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:8px 0;color:var(--muted)">Compras de insumos</td>
        <td style="padding:8px 0;text-align:right">$<%= summary.insumos_total.toLocaleString('es-CO') %></td>
      </tr>
      <tr style="border-bottom:1px solid var(--border)">
        <td style="padding:8px 0;color:var(--muted)">Mano de obra</td>
        <td style="padding:8px 0;text-align:right">$<%= summary.labor_total.toLocaleString('es-CO') %></td>
      </tr>
      <tr>
        <td style="padding:10px 0;font-weight:700">Total gastos</td>
        <td style="padding:10px 0;text-align:right;font-weight:700;font-size:16px">$<%= summary.grand_total.toLocaleString('es-CO') %></td>
      </tr>
    </table>
  </div>

  <div class="form-card" style="max-width:none">
    <h3 style="margin-bottom:16px">Registrar Gastos Fijos</h3>
    <% if (summary.fixed_items.length === 0) { %>
      <p style="color:var(--muted)">No hay categorías activas. <a href="/gastos/categorias">Crear categorías</a>.</p>
    <% } else { %>
    <form action="/gastos/guardar" method="POST" class="expense-form">
      <input type="hidden" name="month" value="<%= month %>">
      <% summary.fixed_items.forEach(item => { %>
        <div class="form-group" style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
          <label style="flex:1;margin:0"><%= item.name %></label>
          <input type="hidden" name="category_id" value="<%= item.category_id %>">
          <input type="number" name="amount" value="<%= item.amount > 0 ? item.amount : '' %>"
                 min="0" step="1000" placeholder="0"
                 style="width:130px;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius)">
        </div>
      <% }) %>
      <div style="text-align:right;margin-top:16px;padding-top:12px;border-top:1px solid var(--border)">
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
    <% } %>
  </div>

</div>

<div class="form-card" style="max-width:none;margin-top:20px">
  <h3 style="margin-bottom:16px">Registrar Gasto Ocasional</h3>
  <form action="/gastos/ocasionales" method="POST" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end">
    <input type="hidden" name="month" value="<%= month %>">
    <div class="form-group" style="margin:0">
      <label>Título *</label>
      <input type="text" name="title" required maxlength="150" placeholder="Ej. Reparación de equipo"
             style="width:220px;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius)">
    </div>
    <div class="form-group" style="margin:0">
      <label>Descripción</label>
      <input type="text" name="description" placeholder="Detalle opcional"
             style="width:260px;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius)">
    </div>
    <div class="form-group" style="margin:0">
      <label>Monto *</label>
      <input type="number" name="amount" required min="0" step="1000" placeholder="0"
             style="width:130px;padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius)">
    </div>
    <div class="form-group" style="margin:0">
      <label>Fecha *</label>
      <input type="date" name="expense_date" required value="<%= month %>-01"
             style="padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius)">
    </div>
    <div class="form-group" style="margin:0">
      <button type="submit" class="btn btn-primary">Registrar</button>
    </div>
  </form>

  <% if (summary.occasional_items.length > 0) { %>
    <div class="table-wrapper" style="margin-top:20px">
      <table class="table">
        <thead>
          <tr><th>Fecha</th><th>Título</th><th>Descripción</th><th>Monto</th><th></th></tr>
        </thead>
        <tbody>
          <% summary.occasional_items.forEach(oe => { %>
            <tr>
              <td><%= new Date(oe.expense_date).toLocaleDateString('es-CO') %></td>
              <td><%= oe.title %></td>
              <td><%= oe.description || '—' %></td>
              <td>$<%= Number(oe.amount).toLocaleString('es-CO') %></td>
              <td>
                <form action="/gastos/ocasionales/<%= oe.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar este gasto ocasional?')">
                  <input type="hidden" name="month" value="<%= month %>">
                  <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
