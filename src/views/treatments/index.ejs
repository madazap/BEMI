<%
  // Conserva los filtros actuales al cambiar solo el segmento desde los contadores
  const qs = (overrides = {}) => {
    const base = {
      segment: filters.segment,
      type:    filters.type,
      search:  filters.search,
      sort:    filters.sort === 'tipo' ? '' : filters.sort
    };
    const merged = Object.assign({}, base, overrides);
    const parts = Object.keys(merged)
      .filter(k => merged[k] !== '' && merged[k] !== null && merged[k] !== undefined)
      .map(k => k + '=' + encodeURIComponent(merged[k]));
    return '/tratamientos' + (parts.length ? '?' + parts.join('&') : '');
  };
  const tiles = [
    { key: '',            label: 'Todos',                    count: stats.total },
    { key: 'activos',     label: 'Activos',                  count: stats.activos },
    { key: 'con_planes',  label: 'Con planes activos',       count: stats.con_planes },
    { key: 'sin_insumos', label: 'Sin insumos configurados', count: stats.sin_insumos, alert: true },
    { key: 'margen_bajo', label: 'Margen bajo (< ' + lowMarginPct + '%)', count: stats.margen_bajo, alert: true },
    { key: 'inactivos',   label: 'Inactivos',                count: stats.inactivos }
  ];
  const TYPE_LABEL = TREATMENT_TYPES;
  const money = n => '$' + Number(n || 0).toLocaleString('es-CO');
%>

<div class="page-actions" style="justify-content:flex-end">
  <a href="/tratamientos/nuevo" class="btn btn-primary">+ Nuevo Tratamiento</a>
</div>

<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
  <% tiles.forEach(t => { %>
    <a href="<%= qs({ segment: t.key }) %>"
       style="text-decoration:none;padding:8px 14px;border-radius:8px;border:1px solid <%= filters.segment === t.key ? '#1a56db' : '#e2e4e0' %>;background:<%= filters.segment === t.key ? '#eef3ff' : '#fff' %>;min-width:92px">
      <span style="display:block;font-size:12px;color:#7a7d78"><%= t.label %></span>
      <strong style="font-size:18px;<%= t.alert && t.count > 0 ? 'color:#c0392b' : '' %>"><%= t.count %></strong>
    </a>
  <% }) %>
</div>

<form method="GET" action="/tratamientos" class="filter-bar" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:20px">
  <div>
    <label class="form-label">Segmento</label>
    <select name="segment" class="form-control" style="width:210px">
      <% tiles.forEach(t => { %>
        <option value="<%= t.key %>" <%= filters.segment === t.key ? 'selected' : '' %>><%= t.key ? t.label : '— Todos —' %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label class="form-label">Tipo</label>
    <select name="type" class="form-control" style="width:200px">
      <option value="">— Todos —</option>
      <% Object.entries(TYPE_LABEL).forEach(([k, v]) => { %>
        <option value="<%= k %>" <%= filters.type === k ? 'selected' : '' %>><%= v %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label class="form-label">Buscar</label>
    <input type="text" name="search" value="<%= filters.search %>" class="form-control" style="width:230px" placeholder="Nombre o descripción">
  </div>
  <div>
    <label class="form-label">Orden</label>
    <select name="sort" class="form-control" style="width:190px">
      <option value="tipo"         <%= filters.sort === 'tipo'         ? 'selected' : '' %>>Tipo y nombre</option>
      <option value="nombre"       <%= filters.sort === 'nombre'       ? 'selected' : '' %>>Nombre (A–Z)</option>
      <option value="margen_desc"  <%= filters.sort === 'margen_desc'  ? 'selected' : '' %>>Mayor margen %</option>
      <option value="margen_asc"   <%= filters.sort === 'margen_asc'   ? 'selected' : '' %>>Menor margen %</option>
      <option value="mas_vendidos" <%= filters.sort === 'mas_vendidos' ? 'selected' : '' %>>Más planes asignados</option>
    </select>
  </div>
  <div>
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/tratamientos" class="btn" style="margin-left:6px">Limpiar</a>
  </div>
</form>

<div style="margin-bottom:12px;color:#7a7d78;font-size:13px">
  <strong><%= treatments.length %></strong> tratamiento(s) encontrado(s)
</div>

<!-- Modal: Configurar Insumos por Tratamiento -->
<div id="insumosModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:10px;width:560px;max-width:95vw;max-height:90vh;overflow-y:auto;padding:28px;box-shadow:0 8px 32px rgba(0,0,0,.18)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
      <h3 style="margin:0;font-size:17px" id="insumosTitle">Insumos del tratamiento</h3>
      <button onclick="closeInsumos()" style="background:none;border:none;font-size:22px;cursor:pointer;color:#7a7d78">&times;</button>
    </div>
    <div id="insumosBody">Cargando...</div>
    <div style="margin-top:20px;display:flex;gap:10px;justify-content:flex-end">
      <button class="btn" onclick="closeInsumos()">Cancelar</button>
      <button class="btn btn-primary" id="insumosGuardar" onclick="saveInsumos()">Guardar</button>
    </div>
  </div>
</div>

<script>
let _treatmentId = null;
let _allProducts = [];

async function openInsumos(btn) {
  const id   = btn.dataset.tid;
  const name = btn.dataset.name;
  _treatmentId = id;
  document.getElementById('insumosTitle').textContent = 'Insumos: ' + name;
  document.getElementById('insumosModal').style.display = 'flex';
  document.getElementById('insumosBody').innerHTML = 'Cargando...';

  try {
    const res = await fetch('/tratamientos/' + id + '/insumos');
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Error al cargar los insumos.');
    _allProducts = data.allProducts;
    renderInsumosForm(data.products);
  } catch (err) {
    document.getElementById('insumosBody').innerHTML =
      '<p style="color:#c0392b">' + (err.message || 'Error al cargar los insumos.') + '</p>';
  }
}

function renderInsumosForm(rows) {
  const opts = _allProducts.map(p =>
    `<option value="${p.id}">${p.generic_name}${p.commercial_name ? ' — ' + p.commercial_name : ''}</option>`
  ).join('');

  let html = `<table style="width:100%;border-collapse:collapse" id="insumosTable">
    <thead><tr>
      <th style="text-align:left;padding:6px 4px;font-size:11px;color:#5F816F;text-transform:uppercase">Producto</th>
      <th style="text-align:left;padding:6px 4px;font-size:11px;color:#5F816F;text-transform:uppercase;width:110px">Cantidad / sesión</th>
      <th style="width:40px"></th>
    </tr></thead>
    <tbody id="insumosTbody">`;

  rows.forEach(r => {
    html += insumosRow(r.product_id, r.quantity, opts);
  });

  html += `</tbody></table>
    <button type="button" class="btn btn-sm" style="margin-top:12px" onclick="addInsumosRow()">+ Agregar producto</button>`;
  document.getElementById('insumosBody').innerHTML = html;
}

function insumosRow(productId, qty, opts) {
  if (!opts) opts = _allProducts.map(p =>
    `<option value="${p.id}">${p.generic_name}${p.commercial_name ? ' — ' + p.commercial_name : ''}</option>`
  ).join('');
  return `<tr>
    <td style="padding:4px">
      <select name="product_id" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:5px">
        <option value="">— Seleccionar —</option>
        ${opts.replace(`value="${productId}"`, `value="${productId}" selected`)}
      </select>
    </td>
    <td style="padding:4px">
      <input type="number" name="quantity" value="${qty || ''}" min="0.001" step="0.001"
             style="width:100%;padding:6px;border:1px solid var(--border);border-radius:5px">
    </td>
    <td style="padding:4px;text-align:center">
      <button type="button" onclick="this.closest('tr').remove()" style="background:none;border:none;color:#c0392b;font-size:18px;cursor:pointer">&times;</button>
    </td>
  </tr>`;
}

function addInsumosRow() {
  document.getElementById('insumosTbody').insertAdjacentHTML('beforeend', insumosRow('', ''));
}

async function saveInsumos() {
  const rows = document.querySelectorAll('#insumosTable tbody tr');
  const product_id = [], quantity = [];
  rows.forEach(r => {
    const p = r.querySelector('[name=product_id]').value;
    const q = r.querySelector('[name=quantity]').value;
    if (p) { product_id.push(p); quantity.push(q); }
  });

  try {
    const res = await fetch('/tratamientos/' + _treatmentId + '/insumos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ product_id, quantity })
    });
    const data = await res.json();
    if (data.ok) {
      closeInsumos();
      alert('Insumos guardados correctamente.');
    } else {
      alert('Error al guardar: ' + (data.error || 'desconocido'));
    }
  } catch (err) {
    alert('Error al guardar: ' + err.message);
  }
}

function closeInsumos() {
  document.getElementById('insumosModal').style.display = 'none';
  _treatmentId = null;
}
</script>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Sesiones</th>
        <th>Precio Venta</th>
        <th>Costo Ejec.</th>
        <th>Margen</th>
        <th>Insumos</th>
        <th>Planes activos</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (treatments.length === 0) { %>
        <tr><td colspan="10" class="text-center">No hay tratamientos con estos filtros.</td></tr>
      <% } %>
      <% treatments.forEach(t => {
           const pct = t.margin_pct === null ? null : Number(t.margin_pct);
           const low = t.is_active && (pct === null || pct < lowMarginPct);
      %>
        <tr class="<%= t.is_active ? '' : 'row-inactive' %>">
          <td><%= t.name %></td>
          <td><span class="badge badge-type"><%= TYPE_LABEL[t.type] || t.type %></span></td>
          <td><%= t.total_sessions %><% if (t.requires_control) { %> <span class="badge badge-type" title="Incluye sesión de control al final">+ control</span><% } %></td>
          <td><%= money(t.sale_price) %></td>
          <td><%= money(t.execution_cost) %></td>
          <td class="<%= Number(t.margin) >= 0 ? '' : 'text-danger' %>">
            <%= money(t.margin) %>
            <% if (pct !== null) { %><br><span class="badge <%= low ? 'badge-warning' : 'badge-active' %>"><%= pct.toFixed(1) %>%</span><% } %>
          </td>
          <td>
            <% if (Number(t.supplies_count) > 0) { %><%= t.supplies_count %>
            <% } else { %><span class="badge <%= t.is_active ? 'badge-danger' : 'badge-inactive' %>">Sin configurar</span><% } %>
          </td>
          <td><%= t.active_plans %></td>
          <td><span class="badge <%= t.is_active ? 'badge-active' : 'badge-inactive' %>"><%= t.is_active ? 'Activo' : 'Inactivo' %></span></td>
          <td class="actions">
            <a href="/tratamientos/<%= t.id %>/editar" class="btn btn-sm">Editar</a>
            <button type="button" class="btn btn-sm btn-primary" data-tid="<%= t.id %>" data-name="<%= t.name %>" onclick="openInsumos(this)">Insumos</button>
            <form action="/tratamientos/<%= t.id %>/toggle" method="POST" style="display:inline">
              <button type="submit" class="btn btn-sm <%= t.is_active ? 'btn-danger' : 'btn-success' %>"
                      onclick="return confirm('<%= t.is_active ? 'Desactivar' : 'Activar' %> este tratamiento?')">
                <%= t.is_active ? 'Desactivar' : 'Activar' %>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
