<form action="/inventario/ingresos" method="POST" class="form-card form-wide" novalidate>

  <div class="form-row">
    <div class="form-group">
      <label for="product_id">Producto *</label>
      <select id="product_id" name="product_id" required>
        <option value="">— Seleccionar —</option>
        <% products.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.generic_name %> (<%= p.sku %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="supplier_id">Proveedor</label>
      <select id="supplier_id" name="supplier_id">
        <option value="">— Sin proveedor —</option>
        <% suppliers.forEach(s => { %>
          <option value="<%= s.id %>"><%= s.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="lot_number">Número de Lote</label>
      <input type="text" id="lot_number" name="lot_number" placeholder="Ej: LOT-2024-001">
    </div>
    <div class="form-group">
      <label for="expiry_date">Fecha de Vencimiento</label>
      <input type="date" id="expiry_date" name="expiry_date">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="purchase_quantity">Cantidad Comprada * <span id="lbl-purchase-unit" class="unit-label"></span></label>
      <input type="number" id="purchase_quantity" name="purchase_quantity" required
             min="0.0001" step="0.0001" placeholder="0">
    </div>
    <div class="form-group">
      <label>Cantidad en Consumo <span id="lbl-consumption-unit" class="unit-label"></span></label>
      <input type="text" id="consumption_quantity_display" readonly class="input-readonly" placeholder="Calculado automáticamente">
      <input type="hidden" id="consumption_quantity" name="consumption_quantity">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="purchase_price">Precio por Unidad de Consumo * <span id="lbl-price-unit" class="unit-label"></span></label>
      <input type="number" id="purchase_price" name="purchase_price" required
             min="0" step="0.01" placeholder="0.00">
    </div>
    <div class="form-group">
      <label>Costo Total</label>
      <input type="text" id="total_cost_display" readonly class="input-readonly" placeholder="Calculado automáticamente">
      <input type="hidden" id="total_cost" name="total_cost">
    </div>
  </div>

  <div class="form-group" style="max-width:240px">
    <label for="entry_date">Fecha de Ingreso *</label>
    <input type="date" id="entry_date" name="entry_date" required value="<%= today %>">
  </div>

  <div class="form-actions">
    <a href="/inventario" class="btn">Cancelar</a>
    <button type="submit" class="btn btn-primary">Registrar Ingreso</button>
  </div>
</form>

<script>
(function () {
  let conversionFactor = 1;

  const productSel    = document.getElementById('product_id');
  const qtyInput      = document.getElementById('purchase_quantity');
  const priceInput    = document.getElementById('purchase_price');
  const consDisplay   = document.getElementById('consumption_quantity_display');
  const consHidden    = document.getElementById('consumption_quantity');
  const costDisplay   = document.getElementById('total_cost_display');
  const costHidden    = document.getElementById('total_cost');
  const lblPurchase   = document.getElementById('lbl-purchase-unit');
  const lblConsumption = document.getElementById('lbl-consumption-unit');
  const lblPrice      = document.getElementById('lbl-price-unit');

  function fmt(n) { return isNaN(n) ? '' : n.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 4 }); }

  function recalculate() {
    const qty   = parseFloat(qtyInput.value) || 0;
    const price = parseFloat(priceInput.value) || 0;
    const cons  = parseFloat((qty * conversionFactor).toFixed(4));
    const cost  = parseFloat((cons * price).toFixed(2));

    consDisplay.value = qty > 0 ? fmt(cons) : '';
    consHidden.value  = qty > 0 ? cons : '';
    costDisplay.value = qty > 0 && price > 0 ? fmt(cost) : '';
    costHidden.value  = qty > 0 && price > 0 ? cost : '';
  }

  productSel.addEventListener('change', async function () {
    const id = this.value;
    if (!id) { conversionFactor = 1; lblPurchase.textContent = ''; lblConsumption.textContent = ''; lblPrice.textContent = ''; recalculate(); return; }
    try {
      const res  = await fetch(`/api/productos/${id}`);
      const data = await res.json();
      conversionFactor = parseFloat(data.conversion_factor) || 1;
      lblPurchase.textContent    = data.purchase_unit   ? `(${data.purchase_unit})`   : '';
      lblConsumption.textContent = data.consumption_unit ? `(${data.consumption_unit})` : '';
      lblPrice.textContent       = data.consumption_unit ? `(${data.consumption_unit})` : '';
      recalculate();
    } catch (e) { console.error(e); }
  });

  qtyInput.addEventListener('input', recalculate);
  priceInput.addEventListener('input', recalculate);
})();
</script>
