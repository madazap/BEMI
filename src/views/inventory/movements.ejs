<form method="GET" action="/inventario/movimientos" class="filter-bar" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:20px">
  <div>
    <label class="form-label">Desde</label>
    <input type="date" name="from" value="<%= filters.from %>" class="form-control" style="width:145px">
  </div>
  <div>
    <label class="form-label">Hasta</label>
    <input type="date" name="to" value="<%= filters.to %>" class="form-control" style="width:145px">
  </div>
  <div>
    <label class="form-label">Producto</label>
    <select name="product_id" class="form-control" style="width:220px">
      <option value="">— Todos —</option>
      <% products.forEach(p => { %>
        <option value="<%= p.id %>" <%= filters.product_id == p.id ? 'selected' : '' %>>
          <%= p.generic_name %><%= p.commercial_name ? ' — ' + p.commercial_name : '' %>
        </option>
      <% }) %>
    </select>
  </div>
  <div>
    <label class="form-label">Tipo</label>
    <select name="type" class="form-control" style="width:170px">
      <option value="">— Todos —</option>
      <option value="entrada"    <%= filters.type === 'entrada'    ? 'selected' : '' %>>Entradas</option>
      <option value="salida"     <%= filters.type === 'salida'     ? 'selected' : '' %>>Salidas (todas)</option>
      <option value="sesion"     <%= filters.type === 'sesion'     ? 'selected' : '' %>>Consumo en sesión</option>
      <option value="vencimiento"<%= filters.type === 'vencimiento'? 'selected' : '' %>>Vencimiento</option>
      <option value="ajuste"     <%= filters.type === 'ajuste'     ? 'selected' : '' %>>Ajuste</option>
      <option value="venta"      <%= filters.type === 'venta'      ? 'selected' : '' %>>Venta de magistral</option>
      <option value="faltante"   <%= filters.type === 'faltante'   ? 'selected' : '' %>>Faltantes (sin stock)</option>
    </select>
  </div>
  <div>
    <button type="submit" class="btn btn-primary">Filtrar</button>
    <a href="/inventario/movimientos" class="btn" style="margin-left:6px">Limpiar</a>
  </div>
</form>

<div style="margin-bottom:12px;color:#7a7d78;font-size:13px">
  <strong><%= movements.length %></strong> movimiento(s) encontrado(s)
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Tipo</th>
        <th>Producto</th>
        <th>Lote</th>
        <th>Vencimiento</th>
        <th style="text-align:right">Cantidad</th>
        <th>Motivo / Detalle</th>
        <th>Registrado por</th>
      </tr>
    </thead>
    <tbody>
      <% if (movements.length === 0) { %>
        <tr><td colspan="8" class="text-center">No hay movimientos en el período seleccionado.</td></tr>
      <% } %>
      <% movements.forEach(m => { const short = m.mov_type === 'faltante'; %>
        <tr<%- short ? ' style="background:#fff8e1"' : '' %>>
          <td style="white-space:nowrap"><%= new Date(m.mov_date).toLocaleDateString('es-CO') %></td>

          <td>
            <% if (m.mov_type === 'entrada') { %>
              <span class="badge badge-active">Entrada</span>
            <% } else if (short) { %>
              <span class="badge badge-warning" title="Consumo registrado sin stock disponible: no se descontó de ningún lote">Faltante</span>
            <% } else if (m.reason === 'sesion') { %>
              <span class="badge" style="background:#e8f0fe;color:#1a73e8">Consumo</span>
            <% } else if (m.reason === 'vencimiento') { %>
              <span class="badge badge-danger" style="background:#fdecea;color:#c0392b">Vencimiento</span>
            <% } else if (m.reason === 'venta') { %>
              <span class="badge" style="background:#f3e8fd;color:#7b3fa0">Venta magistral</span>
            <% } else { %>
              <span class="badge badge-inactive">Ajuste</span>
            <% } %>
          </td>

          <td>
            <strong><%= m.generic_name %></strong>
            <% if (m.commercial_name) { %><br><span style="font-size:11px;color:#7a7d78"><%= m.commercial_name %></span><% } %>
          </td>

          <td style="font-size:12px"><% if (short) { %><span class="badge badge-danger">Sin stock</span><% } else { %><%= m.lot_number || '—' %><% } %></td>

          <td style="font-size:12px;white-space:nowrap">
            <% if (m.expiry_date) { %>
              <% const exp = new Date(m.expiry_date); const now = new Date(); const diff = Math.ceil((exp-now)/(1000*60*60*24)); %>
              <span style="color:<%= diff < 0 ? '#c0392b' : diff < 30 ? '#e67e22' : '#2c2f2c' %>">
                <%= exp.toLocaleDateString('es-CO') %>
              </span>
            <% } else { %>—<% } %>
          </td>

          <td style="text-align:right;font-weight:600;color:<%= m.mov_type === 'entrada' ? '#5F816F' : short ? '#e67e22' : '#c0392b' %>">
            <%= m.mov_type === 'entrada' ? '+' : '-' %><%= Number(m.quantity).toLocaleString('es-CO', {minimumFractionDigits:0, maximumFractionDigits:3}) %>
            <span style="font-size:10px;color:#7a7d78"><%= m.consumption_unit %></span>
          </td>

          <td style="font-size:12px">
            <% if (m.mov_type === 'entrada') { %>
              Ingreso
              <% if (m.supplier_name) { %><br><span style="color:#7a7d78">Proveedor: <%= m.supplier_name %></span><% } %>
              <% if (m.total_cost) { %><br><span style="color:#7a7d78">Costo: $<%= Number(m.total_cost).toLocaleString('es-CO') %></span><% } %>
            <% } else if (short) { %>
              <%= m.reason === 'venta' ? 'Venta de magistral (' + MAGISTRAL_LABEL + ') sin stock' : 'Consumo en sesión #' + m.session_id + ' sin stock' %>
              <% if (m.invoice_id) { %><br><span style="color:#7a7d78">Factura #<%= m.invoice_id %></span><% } %>
              <% if (m.patient_name) { %><br><span style="color:#7a7d78">Paciente: <%= m.patient_name %></span><% } %>
              <br><span style="color:#e67e22">No se descontó de inventario: no había stock disponible.</span>
            <% } else if (m.reason === 'sesion') { %>
              Consumo en sesión #<%= m.session_id %>
              <% if (m.patient_name) { %><br><span style="color:#7a7d78">Paciente: <%= m.patient_name %></span><% } %>
            <% } else if (m.reason === 'vencimiento') { %>
              Salida por vencimiento
            <% } else if (m.reason === 'venta') { %>
              Venta de magistral (<%= MAGISTRAL_LABEL %>)
              <% if (m.invoice_id) { %><br><span style="color:#7a7d78">Factura #<%= m.invoice_id %></span><% } %>
              <% if (m.patient_name) { %><br><span style="color:#7a7d78">Paciente: <%= m.patient_name %></span><% } %>
            <% } else { %>
              Ajuste de inventario
            <% } %>
          </td>

          <td style="font-size:12px;color:#7a7d78"><%= m.registered_by || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div style="margin-top:12px">
  <a href="/inventario" class="btn">← Volver a Inventario</a>
</div>
