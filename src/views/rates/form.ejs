<div class="info-box" style="margin-bottom:20px">
  Registrar una nueva tarifa cerrará automáticamente la tarifa vigente del mismo tipo de servicio.
</div>

<form action="/tarifas" method="POST" class="form-card" novalidate>
  <div class="form-group">
    <label for="service_type">Tipo de Servicio</label>
    <select id="service_type" name="service_type" required>
      <option value="">— Seleccionar —</option>
      <% Object.entries(TREATMENT_TYPES).forEach(([val, lbl]) => { %>
        <option value="<%= val %>"><%= lbl %></option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label for="hourly_rate">Tarifa por hora (COP)</label>
    <input type="number" id="hourly_rate" name="hourly_rate" required
           min="0" step="1000" placeholder="Ej: 150000">
  </div>

  <div class="form-group">
    <label for="effective_from">Vigente desde</label>
    <input type="date" id="effective_from" name="effective_from" required value="<%= today %>">
  </div>

  <div class="form-actions">
    <a href="/tarifas" class="btn">Cancelar</a>
    <button type="submit" class="btn btn-primary">Registrar Tarifa</button>
  </div>
</form>
