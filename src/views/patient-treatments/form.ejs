<form action="/pacientes/<%= patient.id %>/tratamientos" method="POST" class="form-card" novalidate>
  <div class="info-box" style="margin-bottom:20px">
    Asignando tratamiento a: <strong><%= patient.full_name %></strong>
  </div>

  <div class="form-group">
    <label for="treatment_id">Tratamiento *</label>
    <select id="treatment_id" name="treatment_id" required>
      <option value="">— Seleccionar —</option>
      <% treatments.forEach(t => { %>
        <option value="<%= t.id %>">
          <%= t.name %> (<%= TREATMENT_TYPES[t.type] || t.type %>) — <%= t.total_sessions %> sesiones — $<%= Number(t.sale_price).toLocaleString('es-CO') %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label>Plan de Pago *</label>
    <div class="checkbox-group">
      <label class="checkbox-label">
        <input type="radio" name="payment_plan" value="por_sesion" checked> Por sesión
      </label>
      <label class="checkbox-label">
        <input type="radio" name="payment_plan" value="paquete"> Paquete completo
      </label>
    </div>
  </div>

  <div class="form-group">
    <label for="start_date">Fecha de Inicio *</label>
    <input type="date" id="start_date" name="start_date" required
           value="<%= new Date().toISOString().slice(0,10) %>">
  </div>

  <div class="form-actions">
    <a href="/pacientes/<%= patient.id %>" class="btn">Cancelar</a>
    <button type="submit" class="btn btn-primary">Asignar y Crear Sesiones</button>
  </div>
</form>
